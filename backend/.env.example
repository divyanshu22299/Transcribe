# Gemini API Key (Required for transcription and transliteration)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection: gemini-2.5-flash (recommended for speed & quality) or gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Default Target Language & Script (Can also be chosen per file)
DEFAULT_LANGUAGE=Hindi
DEFAULT_SCRIPT=Devanagari

# Karya Segmentation Limits (Defaults strictly conform to guidelines)
MAX_SEGMENT_DURATION=20.0
MIN_SEGMENT_DURATION=0.5
SEGMENT_BUFFER_SEC=0.3
MAX_SILENCE_SEC=4.0
